# Environment and Secret Configurations
.env
.env.local
.env.*.local

# Dependencies
node_modules/

# Uploads & Generated Outputs (preserve directory via gitkeep)
uploads/*
!uploads/.gitkeep
results/*
!results/.gitkeep
exports/*
!exports/.gitkeep

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python cache (if scripts used)
__pycache__/
*.pyc

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
